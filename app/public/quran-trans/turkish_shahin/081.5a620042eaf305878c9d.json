{"формат":1,"ключ":"turkish_shahin","сура":81,"аяты":[["Güneş katlanıp dürüldüğünde,",null],["Yıldızlar (kararıp) döküldüğünde,",null],["Dağlar (sallanıp) yürütüldüğünde,",null],["Gebe develer salıverildiğinde,",null],["Vahşî hayvanlar toplanıp bir araya getirildiğinde,",null],["Denizler kaynatıldığında,",null],["Ruhlar (bedenlerle) birleştirildiğinde,",null],["Diri diri toprağa gömülen kıza, sorulduğunda,",null],["hangi günah sebebiyle öldürüldüğü,",null],["(Amellerin yazılı olduğu) defterler açıldığında,",null],["Gökyüzü sıyrılıp alındığında,",null],["cehennem tutuşturulduğunda",null],["ve cennet yaklaştırıldığında,",null],["Kişi neler getirdiğini öğrenmiş olacaktır.",null],["Hayır! (Gündüz) sinen,",null],["akıp giden, etrafı aydınlatan yıldızlara andolsun,",null],["Kararmaya yüz tuttuğunda geceye andolsun,",null],["Ağarmaya başladığında sabaha andolsun ki,",null],["itibarlı bir elçinin (Cebrail'in) getirdiği sözdür.",null],["O (Kur'an), şüphesiz değerli, güçlü ve Arş'ın sahibi (Allah'ın) katında",null],["O orada sayılan, güvenilen (elçi)'dir.",null],["Arkadaşınız (Muhammed) de mecnun değildir.",null],["Andolsun ki, onu (Cebrail'i) apaçık ufukta görmüştür.",null],["O, gaybın bilgilerini (sizden) esirgemez.",null],["O lanetlenmiş şeytanın sözü de değildir.",null],["Hal böyle iken nereye gidiyorsunuz?",null],["O, herkes için, bir öğüttür.",null],["Sizden doğru yolda gitmek isteyenler için.",null],["Âlemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz.",null]]}
