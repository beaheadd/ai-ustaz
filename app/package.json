{
  "name": "aiustaz",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear && node scripts/after-export.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "build:web": "npm run export:web && npm run check:dist",
    "serve:test": "node scripts/serve-test.mjs",
    "test:web": "node scripts/smoke-test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:speech": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-speech.mjs",
    "test:theme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-theme.mjs",
    "test:prayer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-prayer.mjs",
    "test:qibla": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-qibla.mjs",
    "test:quran": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-quran.mjs",
    "test:audio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-audio.mjs && node --disable-warning=ExperimentalWarning scripts/e2e-audio.mjs",
    "test:install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-install.mjs",
    "test:notify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-notify.mjs",
    "test:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-i18n.mjs",
    "licenses": "node scripts/gen-licenses.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/amiri-quran": "0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "adhan": "4.4.6",
    "expo": "~58.0.26",
    "expo-font": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
